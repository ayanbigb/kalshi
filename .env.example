# Copy to .env and fill in. Never commit .env or your private key.

# --- Kalshi (only needed for live orders / real balance; market data is public) ---
# Create at kalshi.com -> Account & security -> API keys. Download the private key file.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/kalshi-private-key.pem
# ...or the key text itself (one line, newlines written as \n), e.g. in a cloud environment's settings
KALSHI_PRIVATE_KEY=
# Third safety latch: ANY non-GET request (orders, cancels, RFQs) is refused unless this is 1 too
KALSHI_ALLOW_ORDERS=0
# Second safety latch: live orders are refused unless this is 1 AND you pass --live
KALSHI_LIVE_TRADING=0

# --- Optional: sportsbook prop lines to anchor the model (the-odds-api.com) ---
ODDS_API_KEY=
